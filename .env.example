# Copy this file to .env for docker compose. Do not commit .env.

# Where events get forwarded to
RELAY_DESTINATION_URL=https://example.com/incoming

# Needed in the X-Api-Key header for /events, /stats, /backfill
RELAY_ADMIN_API_KEY=change-me

# Shared secret for the "demo" source (used to check webhook signatures)
RELAY_DEMO_SECRET=change-me-too

# Most calls to the destination per day (UTC)
RELAY_DAILY_CALL_BUDGET=1000
