{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Relay": "Data Source=relay.db"
  },
  "Relay": {
    "DestinationUrl": "",
    "AdminApiKey": "",
    "DailyCallBudget": 1000,
    "MaxAttempts": 5,
    "BaseDelaySeconds": 30,
    "MaxDelaySeconds": 3600,
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "RetentionDays": 30,
    "CleanupIntervalMinutes": 60,
    "Sources": {}
  }
}
